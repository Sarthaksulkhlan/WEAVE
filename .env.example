# WEAVE (SIH26263) local development template
# Never commit real credentials or private keys.

# ---------- Shared ----------
APP_ENV=development
APP_NAME=WEAVE
LOG_LEVEL=INFO

# ---------- API (apps/api) ----------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1
API_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=weave_dev
POSTGRES_USER=weave_app
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=<set-local-postgresql-connection-string>

# Worker queue (PostgreSQL-backed)
WORKER_POLL_INTERVAL_SECONDS=2

# Ed25519 signing material (development placeholders only)
# Use generated throwaway keys for local development; never commit real keys.
ATTESTATION_PRIVATE_KEY_PEM_PATH=./secrets/dev-attestation-private.pem
ATTESTATION_PUBLIC_KEY_PEM_PATH=./secrets/dev-attestation-public.pem

# ---------- Web (apps/web) ----------
VITE_APP_NAME=WEAVE
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MSW=true
VITE_MSW_LABEL=SYNTHETIC-DEVELOPMENT-DATA

# ---------- Optional AI Copilot ----------
# Keep disabled by default until MVP is stable.
ENABLE_ADMIN_COPILOT=false
